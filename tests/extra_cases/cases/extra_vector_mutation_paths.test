CREATE TABLE t (id BIGINT PRIMARY KEY, g BIGINT, v VECTOR(2));
INSERT INTO t VALUES (1,1,'[0,0]'),(2,1,'[1,1]'),(3,2,'[2,2]');
CREATE VECTOR INDEX vi ON t(v);
SELECT id, L2_DISTANCE(v,'[0,0]') AS d FROM t ORDER BY d;
UPDATE t SET v = '[9,9]' WHERE id = 1;
SELECT id, L2_DISTANCE(v,'[0,0]') AS d FROM t ORDER BY d;
DELETE FROM t WHERE id = 3;
SELECT id, L2_DISTANCE(v,'[0,0]') AS d FROM t ORDER BY d;
SELECT id, L2_DISTANCE(v,'[0,0]') AS d FROM t WHERE g = 1 ORDER BY d;
