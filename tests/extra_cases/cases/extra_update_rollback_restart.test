CREATE TABLE docs (id BIGINT PRIMARY KEY, s VARCHAR(8), v VECTOR(2));
INSERT INTO docs VALUES (1,'before','[0,0]');
BEGIN;
UPDATE docs SET s = 'during', v = '[9,9]' WHERE id = 1;
SELECT s FROM docs WHERE id = 1;
ROLLBACK;
SELECT s FROM docs WHERE id = 1;
--restart
SELECT id, s, L2_DISTANCE(v,'[0,0]') AS d FROM docs ORDER BY id;
