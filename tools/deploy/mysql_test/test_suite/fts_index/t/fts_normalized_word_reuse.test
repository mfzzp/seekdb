# Already normalized keys must remain valid until the result is consumed.
# Mixed borrowed and copied keys retain frequency and last-spelling semantics.
--disable_query_log
--disable_warnings
DROP DATABASE IF EXISTS fts_normalized_word_reuse;
--enable_warnings
CREATE DATABASE fts_normalized_word_reuse;
USE fts_normalized_word_reuse;
SET NAMES utf8mb4;
SET @tokens = TOKENIZE('alpha beta ALPHA gamma beta delta', 'space', '[{"output":"all"}]');
SELECT JSON_CONTAINS(@tokens, '{"alpha":2}', '$.tokens') AND JSON_CONTAINS(@tokens, '{"beta":2}', '$.tokens') AND JSON_CONTAINS(@tokens, '{"gamma":1}', '$.tokens') AND JSON_EXTRACT(@tokens, '$.doc_len') = 6 AS mixed_key_storage;
SET @tokens = TOKENIZE('zebra zebra ZEBRA orchard orchard', 'beng', '[{"output":"all"}]');
SELECT JSON_CONTAINS(@tokens, '{"zebra":3}', '$.tokens') AND JSON_CONTAINS(@tokens, '{"orchard":2}', '$.tokens') AS analyzer_key_lifetime;
SET @tokens = TOKENIZE('cafe CAFÉ café cafe', 'ngram', '[{"output":"all"}]');
SELECT JSON_CONTAINS(@tokens, '{"fe":4}', '$.tokens') AND NOT JSON_CONTAINS(@tokens, '{"fé":4}', '$.tokens') AS borrowed_last_spelling;
SET @tokens = TOKENIZE('cafe CAFÉ café', 'ngram', '[{"output":"all"}]');
SELECT JSON_CONTAINS(@tokens, '{"fé":3}', '$.tokens') AS unicode_last_spelling;
SET @tokens = TOKENIZE(CONCAT(REPEAT('alpha beta gamma ', 400), 'ALPHA'), 'space', '[{"output":"all"}]');
SELECT JSON_CONTAINS(@tokens, '{"alpha":401}', '$.tokens') AND JSON_CONTAINS(@tokens, '{"beta":400}', '$.tokens') AND JSON_EXTRACT(@tokens, '$.doc_len') = 1201 AS long_document_mixed_keys;
SELECT JSON_LENGTH(TOKENIZE('the is a', 'space')) = 0 AS empty_following_document;
CREATE TABLE docs(id INT PRIMARY KEY, body TEXT);
INSERT INTO docs VALUES (1, 'alpha beta'), (2, 'BETA gamma'), (3, 'unrelated'), (4, 'alpha ALPHA');
ALTER TABLE docs ADD FULLTEXT INDEX fti(body) WITH PARSER space;
SELECT COUNT(*) = 3 AS match_filter FROM docs WHERE MATCH(body) AGAINST('alpha beta');
SELECT COUNT(*) = 3 AS score_predicate FROM docs WHERE MATCH(body) AGAINST('alpha beta') > 0;
SELECT COUNT(*) = 2 AS combined_filter FROM docs WHERE MATCH(body) AGAINST('alpha beta') AND id > 1;
SELECT COUNT(*) = 1 AND MIN(id) = 1 AS boolean_filter FROM docs WHERE MATCH(body) AGAINST('+alpha +beta' IN BOOLEAN MODE);
SELECT COUNT(*) = 2 AS offset_and_limit FROM (SELECT id FROM docs WHERE MATCH(body) AGAINST('alpha beta') LIMIT 1,2) s;
SELECT COUNT(*) = 3 AND MIN(score) > 0 AS projected_score FROM (SELECT MATCH(body) AGAINST('alpha beta') AS score FROM docs WHERE MATCH(body) AGAINST('alpha beta')) s;
DROP DATABASE fts_normalized_word_reuse;
--enable_query_log
