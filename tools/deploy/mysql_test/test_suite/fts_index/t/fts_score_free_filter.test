# Membership-only MATCH must deduplicate postings without changing score users.
--disable_query_log
--disable_warnings
DROP DATABASE IF EXISTS fts_score_free_filter;
--enable_warnings
CREATE DATABASE fts_score_free_filter;
USE fts_score_free_filter;
CREATE TABLE docs(id INT PRIMARY KEY, body TEXT, category INT);
INSERT INTO docs VALUES (1,'alpha beta',1),(2,'alpha alpha alpha',1),(3,'beta gamma',2),(4,'unrelated',2),(5,NULL,3),(6,'',3),(7,'the is a',3);
ALTER TABLE docs ADD FULLTEXT INDEX fti(body) WITH PARSER space;
SELECT COUNT(*) = 3 AS posting_union FROM docs WHERE MATCH(body) AGAINST('alpha beta');
SELECT COUNT(*) = 3 AS repeated_query_terms FROM docs WHERE MATCH(body) AGAINST('alpha alpha beta beta');
SELECT COUNT(*) = 1 AS ordinary_predicate FROM docs WHERE MATCH(body) AGAINST('alpha beta') AND category = 2;
SELECT SUM(id) = 6 AND COUNT(body) = 3 AS aggregate_membership FROM docs WHERE MATCH(body) AGAINST('alpha beta');
SELECT COUNT(*) = 0 AS empty_query FROM docs WHERE MATCH(body) AGAINST('');
SELECT COUNT(*) = 0 AS null_query FROM docs WHERE MATCH(body) AGAINST(NULL);
SELECT COUNT(*) = 0 AS stopword_query FROM docs WHERE MATCH(body) AGAINST('the is a');
SELECT COUNT(*) = 0 AS missing_query FROM docs WHERE MATCH(body) AGAINST('missingtoken');
SELECT COUNT(*) = 3 AS positive_threshold FROM docs WHERE MATCH(body) AGAINST('alpha beta') > 0;
SELECT COUNT(*) = 0 AS high_threshold FROM docs WHERE MATCH(body) AGAINST('alpha beta') > 1000;
SELECT COUNT(*) = 3 AND MIN(score) > 0 AS score_projection FROM (SELECT MATCH(body) AGAINST('alpha beta') AS score FROM docs WHERE MATCH(body) AGAINST('alpha beta')) s;
SELECT COUNT(*) = 1 AND MIN(id) = 2 AS boolean_exclusion FROM docs WHERE MATCH(body) AGAINST('+alpha -beta' IN BOOLEAN MODE);
SELECT COUNT(*) = 1 AND MIN(id) = 1 AS boolean_intersection FROM docs WHERE MATCH(body) AGAINST('+alpha +beta' IN BOOLEAN MODE);
SELECT COUNT(*) = 2 AS implicit_rank_limit FROM (SELECT id FROM docs WHERE MATCH(body) AGAINST('alpha beta') LIMIT 2) s;
SELECT COUNT(*) = 1 AS rank_offset FROM (SELECT id FROM docs WHERE MATCH(body) AGAINST('alpha beta') ORDER BY MATCH(body) AGAINST('alpha beta') DESC, id LIMIT 2,1) s;
SELECT COUNT(*) = 4 AS match_disjunction FROM docs WHERE MATCH(body) AGAINST('alpha beta') OR id = 4;
SELECT COUNT(*) = 2 AS two_match_filters FROM docs WHERE MATCH(body) AGAINST('alpha beta') AND MATCH(body) AGAINST('alpha');
PREPARE membership FROM 'SELECT COUNT(*) = ? AS prepared_membership FROM docs WHERE MATCH(body) AGAINST(?)';
SET @expected = 3, @terms = 'alpha beta';
EXECUTE membership USING @expected, @terms;
SET @expected = 0, @terms = 'missingtoken';
EXECUTE membership USING @expected, @terms;
SET @expected = 2, @terms = 'alpha';
EXECUTE membership USING @expected, @terms;
DEALLOCATE PREPARE membership;
BEGIN;
INSERT INTO docs VALUES(8,'alpha beta',4);
SELECT COUNT(*) = 4 AS own_insert FROM docs WHERE MATCH(body) AGAINST('alpha beta');
ROLLBACK;
SELECT COUNT(*) = 3 AS rollback_membership FROM docs WHERE MATCH(body) AGAINST('alpha beta');
UPDATE docs SET body = 'alpha' WHERE id = 4;
DELETE FROM docs WHERE id = 1;
SELECT COUNT(*) = 3 AND SUM(id) = 9 AS update_delete_membership FROM docs WHERE MATCH(body) AGAINST('alpha beta');
SET SESSION group_concat_max_len = 65535;
WITH RECURSIVE words(n) AS (SELECT 0 UNION ALL SELECT n+1 FROM words WHERE n < 299) SELECT GROUP_CONCAT(CONCAT('word',n) SEPARATOR ' ') INTO @many_terms FROM words;
INSERT INTO docs VALUES(9,@many_terms,5),(10,@many_terms,5);
PREPARE many_membership FROM 'SELECT COUNT(*) = 2 AS many_term_union FROM docs WHERE MATCH(body) AGAINST(?)';
EXECUTE many_membership USING @many_terms;
DEALLOCATE PREPARE many_membership;
DROP DATABASE fts_score_free_filter;
--enable_query_log
